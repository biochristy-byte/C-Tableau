<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.datadivers.vizext.sketchbook" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Sketchbook: hand-drawn bar, line and dot charts. Pencil-style strokes with hachure, solid or zigzag fills, drawn with a fixed seed so the sketch never wobbles between renders. Roughness, bowing and seed are steppers in the in-viz settings panel.</description>
    <author name="Chris Fryar" email="" organization="Data Divers" website="https://datadivers.com"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>http://localhost:8773/src/index.html</url>
    </source-location>
    <icon/>
    <permissions>
      <permission>full data</permission>
    </permissions>

    <encoding id="category">
      <display-name resource-id="enc-category">Category</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-c"/>
      <tooltip resource-id="tip-category">The dimension along the bottom: one bar, dot or line point per category. Data order is kept unless you sort in the settings.</tooltip>
    </encoding>

    <encoding id="value">
      <display-name resource-id="enc-value">Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-v"/>
      <tooltip resource-id="tip-value">The measure that sets how tall each bar is, or how high each dot or line point sits.</tooltip>
    </encoding>

    <encoding id="series">
      <display-name resource-id="enc-series">Series</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip resource-id="tip-series">Optional. Splits the chart into colored series: grouped bars, several lines, or side by side dots.</tooltip>
    </encoding>

    <encoding id="label">
      <display-name resource-id="enc-label">Label</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="text"/>
      <tooltip resource-id="tip-label">Optional. Text written above each mark when Mark labels is set to Label shelf.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Sketchbook</text>
    </resource>
    <resource id="enc-category">
      <text locale="en_US">Category</text>
    </resource>
    <resource id="tip-category">
      <text locale="en_US">The dimension along the bottom: one bar, dot or line point per category. Data order is kept unless you sort in the settings.</text>
    </resource>
    <resource id="enc-value">
      <text locale="en_US">Value</text>
    </resource>
    <resource id="tip-value">
      <text locale="en_US">The measure that sets how tall each bar is, or how high each dot or line point sits.</text>
    </resource>
    <resource id="enc-series">
      <text locale="en_US">Series</text>
    </resource>
    <resource id="tip-series">
      <text locale="en_US">Optional. Splits the chart into colored series: grouped bars, several lines, or side by side dots.</text>
    </resource>
    <resource id="enc-label">
      <text locale="en_US">Label</text>
    </resource>
    <resource id="tip-label">
      <text locale="en_US">Optional. Text written above each mark when Mark labels is set to Label shelf.</text>
    </resource>
  </resources>
</manifest>
