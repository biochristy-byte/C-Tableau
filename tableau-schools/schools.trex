<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.datadivers.vizext.schools" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Schools: Dorling-style clustered bubbles. One circle per mark, sized by a measure, pulled into schools by a category and settled by a force simulation so no two circles overlap.</description>
    <author name="Chris Fryar" email="" organization="Data Divers" website="https://datadivers.com"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>http://localhost:8771/src/index.html</url>
    </source-location>
    <icon/>
    <permissions>
      <permission>full data</permission>
    </permissions>

    <encoding id="item">
      <display-name resource-id="enc-item">Item</display-name>
      <data-spec><data-type>string</data-type></data-spec>
      <role-spec><role-type>discrete-dimension</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-c"/>
      <tooltip resource-id="tip-item">One circle per value of this dimension. Required.</tooltip>
    </encoding>

    <encoding id="cluster">
      <display-name resource-id="enc-cluster">Cluster</display-name>
      <data-spec><data-type>string</data-type></data-spec>
      <role-spec><role-type>discrete-dimension</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-c"/>
      <tooltip resource-id="tip-cluster">The dimension that groups circles into schools.</tooltip>
    </encoding>

    <encoding id="size">
      <display-name resource-id="enc-size">Size</display-name>
      <data-spec><data-type>numeric</data-type></data-spec>
      <role-spec><role-type>continuous-measure</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="size"/>
      <tooltip resource-id="tip-size">The measure that sets each circle's area.</tooltip>
    </encoding>

    <encoding id="color">
      <display-name resource-id="enc-color">Color</display-name>
      <data-spec><data-type>string</data-type></data-spec>
      <role-spec><role-type>discrete-dimension</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip resource-id="tip-color">Optional. Colors circles by this dimension when Color by is set to Color shelf.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Schools</text></resource>
    <resource id="enc-item"><text locale="en_US">Item</text></resource>
    <resource id="enc-cluster"><text locale="en_US">Cluster</text></resource>
    <resource id="enc-size"><text locale="en_US">Size</text></resource>
    <resource id="enc-color"><text locale="en_US">Color</text></resource>
    <resource id="tip-item"><text locale="en_US">One circle per value of this dimension. Required.</text></resource>
    <resource id="tip-cluster"><text locale="en_US">The dimension that groups circles into schools.</text></resource>
    <resource id="tip-size"><text locale="en_US">The measure that sets each circle's area.</text></resource>
    <resource id="tip-color"><text locale="en_US">Optional. Colors circles by this dimension.</text></resource>
  </resources>
</manifest>
